# Local Postgres (docker compose up -d db). Published on 5433 — 5432 is often already taken.
DATABASE_URL=postgres://searchops:searchops@localhost:5433/searchops

# Exa — semantic web search, used for competitor discovery.
EXA_API_KEY=
