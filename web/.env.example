# SearchOps — environment
#
# Copy to .env.local and fill in what you need. Never commit .env.local.
#
# ── You can run the whole thing locally with NONE of this set ──────
#
# With no .env.local at all, `pnpm dev` works and every page renders:
#   * Sign-in is OPEN — one provider, any email, no password, no domain
#     check. This is NOT dev-gated: it behaves the same wherever you run
#     it, so anyone who can reach the URL can sign in as anyone. Fine on
#     localhost; restore a real provider in auth.ts before any public host.
#   * The database falls back to an empty stub — reads return no rows,
#     writes are discarded, and one warning names the missing variables.
#     This one IS dev-only: in production a missing credential still
#     throws, because silently reading zero rows is worse than not starting.
#   * AUTH_SECRET gets a fixed, obviously-fake value.
#
# So fill these in when you want real data, not to get it running.
# Every integration below is read lazily and fails at call time with a
# message naming the variable — not at import or build time.
#
# Grouped by what it unlocks. Start with TIER 1; add the rest as you reach
# for the feature that needs it.


# ═══════════════════════════════════════════════════════════════════
# TIER 1 — minimum to sign in and store anything
# ═══════════════════════════════════════════════════════════════════

# next-auth v5 reads AUTH_SECRET from the environment by name.
AUTH_SECRET=                      # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000     # used to build absolute links in jobs and emails

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / ALLOWED_DOMAINS are no longer
# read. Sign-in is OPEN: one provider, any email, no password, no domain
# check. See auth.ts. The Settings page still lists these three as required —
# that is stale metadata, not a live requirement.

# Supabase. SUPABASE_URL is read BEFORE NEXT_PUBLIC_SUPABASE_URL on purpose:
# NEXT_PUBLIC_* is inlined at build time, so a value absent during the build
# bakes in as undefined and setting it at runtime would not help.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Listed as required by the Settings page, but NOT actually read by any code
# here — the browser client that needed it was removed. Only set it if you add
# client-side queries. (Settings is showing stale metadata.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Elevated access inside the app (comma-separated emails).
ADMIN_EMAILS=
SUPERUSER_EMAILS=


# ═══════════════════════════════════════════════════════════════════
# TIER 2 — the check loop: crawl, render, diagnose
# ═══════════════════════════════════════════════════════════════════

# Empty falls back to static fetching, which covers roughly 85% of sites.
# Set to 1 to run the headless browser — required for renderMode to diff
# raw against rendered HTML, which is how JS-gated content is detected.
PLAYWRIGHT_ENABLED=

PAGESPEED_API_KEY=                # Core Web Vitals via the CrUX API

# Google Search Console — impressions, clicks, CTR, position.
# Supply ONE of the service-account forms; BASE64 is easier in a container.
GSC_SA_JSON=                      # raw service-account JSON
GSC_SA_JSON_BASE64=               # or the same JSON, base64-encoded
GSC_PROPERTY=                     # e.g. sc-domain:example.com

# Repo writes — turning a finding into a pull request.
GITHUB_BOT_TOKEN=                 # scope to one repo; a GitHub App is the better end state
REPO_MAP=                         # maps live URLs to the files that render them
TARGET_REPO_BASE_BRANCH=main

RENDER_LAB_WRITES=                # set to allow render-lab to write, not just report


# ═══════════════════════════════════════════════════════════════════
# TIER 3 — the answer-engine benchmark (the differentiator)
# ═══════════════════════════════════════════════════════════════════

OPENROUTER_API_KEY=               # one key, several models — the benchmark fan-out
OPENAI_API_KEY=                   # gpt-4o-mini-search-preview returns url_citations
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
PROVIDER_FREE_ONLY=               # set to 1 to refuse paid model calls

SERPER_API_KEY=                   # Google AI Overview surface
TAVILY_API_KEY=
TAVILY_MONTHLY_LIMIT=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
SEARXNG_TOKEN=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SGAI_API_KEY=                     # scrapegraph

# Otterly — prompt-panel tracking. Optional if the fixed question set replaces it.
OTTERLY_API_KEY=
OTTERLY_REPORT_ID=
OTTERLY_COUNTRY=

# Endpoint that receives AI crawler hits and referrals for the GEO dashboard.
GEO_INGEST_SECRET=


# ═══════════════════════════════════════════════════════════════════
# TIER 4 — jobs, cache, scheduling
# ═══════════════════════════════════════════════════════════════════

CRON_SECRET=                      # guards every scheduled route — set this before deploying
QSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ═══════════════════════════════════════════════════════════════════
# TIER 5 — SEO data providers (all optional)
# ═══════════════════════════════════════════════════════════════════

AHREFS_API_KEY=
OPENPAGERANK_API_KEY=
BLITZ_API_KEY=


# ═══════════════════════════════════════════════════════════════════
# TIER 6 — ported from Summit, NOT on the SearchOps check path
# Outreach, publishing and messaging. Leave blank unless you turn these on.
# ═══════════════════════════════════════════════════════════════════

