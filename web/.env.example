# SearchOps — environment
#
# Nothing here is required to render the marketing page at /. The (tool)
# routes degrade gracefully without credentials: auth reports MissingSecret,
# no session is established, and the operator chrome stays hidden.
#
# Copy to .env.local and fill what you actually need. Never commit .env.local.

# ── Required for the operator surface to sign anyone in ──────────────
AUTH_SECRET=                  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAINS=              # e.g. imagine.art — restricts who may sign in

# ── Store ────────────────────────────────────────────────────────────
SUPABASE_URL=                 # read before NEXT_PUBLIC_SUPABASE_URL, on purpose:
NEXT_PUBLIC_SUPABASE_URL=     # NEXT_PUBLIC_* is inlined at build time
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Models: the answer-engine benchmark ──────────────────────────────
OPENROUTER_API_KEY=           # one key, several models — the benchmark fan-out
OPENAI_API_KEY=               # gpt-4o-mini-search-preview, returns url_citations
GOOGLE_API_KEY=               # Gemini

# ── Search and retrieval ─────────────────────────────────────────────
SERPER_API_KEY=               # Google AI Overview surface
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
SGAI_API_KEY=                 # scrapegraph

# ── Checks ───────────────────────────────────────────────────────────
PLAYWRIGHT_ENABLED=           # empty falls back to static fetch (~85% of sites)
PAGESPEED_API_KEY=            # Core Web Vitals via CrUX
AHREFS_API_KEY=
OPENPAGERANK_API_KEY=
OTTERLY_API_KEY=              # prompt-panel tracking

# ── Repo writes (open the PR) ────────────────────────────────────────
GITHUB_TOKEN=                 # scope to one repo; a GitHub App is the better end state

# ── Jobs and cache ───────────────────────────────────────────────────
QSTASH_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=                  # guards every scheduled route

# ── Outreach side (ported from Summit; not on the SearchOps check path)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
STRAPI_URL=
STRAPI_API_TOKEN=
SLACK_BOT_TOKEN=
NOTION_TOKEN=
