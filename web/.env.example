# SearchOps — the environment the audit → connect → agent spine actually reads.
# Anything not listed here is not read by this code.

# ── Core ─────────────────────────────────────────────────────────────────────

# Local Postgres (docker compose up -d db, published on 5433). Without it the
# audit still runs — reads return empty and writes throw.
DATABASE_URL=postgres://searchops:searchops@localhost:5433/searchops

# OpenRouter key. Powers the reasoning model (prompt writing, suggestions,
# generated files), the share-of-voice answer engine, and the agent itself.
OPENROUTER_API_KEY=

# Exa — semantic competitor discovery. Unset: discovery runs on supplied
# competitor names only.
EXA_API_KEY=

# Where links in Slack posts should point. Falls back to the request host.
APP_URL=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────

# next-auth session secret. The sign-in provider accepts ANY email with no
# password — fine on localhost, never on a public hostname.
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Bearer token for machine callers (cron triggers, /api/slack/post).
CRON_SECRET=

# ── Slack ────────────────────────────────────────────────────────────────────

# From the Slack app (scopes: chat:write, commands; events: app_mention, DMs).
# Unset signing secret = every Slack endpoint fails closed, by design.
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=

# Sim script overrides (scripts/slack-sim.mjs).
SLACK_SIM_CHANNEL=
SLACK_SIM_TEAM=
SLACK_SIM_USER=
SLACK_SIM_BASE=http://localhost:3000

# ── Connections ──────────────────────────────────────────────────────────────

# 32-byte key for encrypting tokens into connections.secret_enc.
# `openssl rand -hex 32`. Unset: connections without secrets still save;
# storing a token refuses loudly.
CONNECTIONS_KEY=

# ── Google Search Console (publish stage) ────────────────────────────────────

# Service account JSON, inline or base64. The user adds its email as a user on
# their Search Console property — no Google review needed.
GSC_SA_JSON=
# GSC_SA_JSON_BASE64=
GSC_PROPERTY=

# ── GitHub (fix stage, executor) ─────────────────────────────────────────────

# Repo token + path→repo mapping for opening PRs. Per-site tokens live in the
# connections table; these are the shared fallback.
GITHUB_BOT_TOKEN=
REPO_MAP=
TARGET_REPO_BASE_BRANCH=main

# ── Email (earn stage, executor) ─────────────────────────────────────────────

# Gmail SMTP via app password — the sender the outreach loop sends as.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# ── Optional ─────────────────────────────────────────────────────────────────

# Playwright render pass in the audit (JS-gated check). Off = raw fetch only.
PLAYWRIGHT_ENABLED=1

# PageSpeed/CWV signals inside the indexing chain.
PAGESPEED_API_KEY=
GOOGLE_API_KEY=

# Admin gate for per-person reporting endpoints.
ADMIN_EMAILS=
SUPERUSER_EMAILS=

# Agent bearer token, distinct from CRON_SECRET so it can be rotated alone.
HERMES_TOKEN=
HERMES_ALLOW_ADMIN=
